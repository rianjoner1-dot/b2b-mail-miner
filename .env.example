# ==============================================================
#  B2B-MAIL-MINER — Configuração de Exemplo
#  Copie este arquivo como .env e preencha com seus dados reais:
#  cp .env.example .env
# ==============================================================

# Seu e-mail de envio (ex: Gmail)
EMAIL_USER=seu_email@gmail.com

# Senha de App de 16 letras gerada no Google Account:
# (myaccount.google.com/apppasswords)
EMAIL_PASS=sua_senha_de_app_16_digitos

# Intervalo padrão em minutos entre cada disparo (para evitar filtro anti-spam)
INTERVAL_MINUTES=10

# Caminho opcional do arquivo PDF a ser anexado em cada envio
# ATTACHMENT_PATH=./meu_arquivo.pdf
